# Copy to .env and fill in. .env is gitignored.

# Clerk publishable key, from the Clerk dashboard's API keys page.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Where the API is reachable from the device running the app.
#   physical device  -> your machine's LAN IP, e.g. http://192.168.1.42:5002
#   Android emulator -> http://10.0.2.2:5002
#   iOS simulator    -> http://localhost:5002
EXPO_PUBLIC_API_BASE=http://localhost:5002
